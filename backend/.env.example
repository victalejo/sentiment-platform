# Copia este archivo a .env y ajusta los valores.
# NO subas .env al control de versiones (ya está en .gitignore).

# --- Base de datos ---
# Producción (MySQL):
#   DATABASE_URL=mysql+pymysql://usuario:password@localhost:3306/sentiment_db
# Si se deja vacío/sin definir, el backend usa SQLite local (sentiment_platform.db),
# útil para desarrollo y pruebas sin una base de datos externa.
DATABASE_URL=

# --- Seguridad ---
# Clave para firmar los JWT. Genera una aleatoria, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-en-produccion
